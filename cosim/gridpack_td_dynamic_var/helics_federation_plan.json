{
  "name": "gridpack_opendss_dynamic_var_study",
  "status": "configured_real_travis150_gridpack_case",
  "federation_layer": "HELICS",
  "transmission_federate": {
    "backend": "GridPACK dynamic_simulation_full_y/dsf.x",
    "case_requirement": "Travis150-updated/150.RAW plus Travis150-updated/150_gridpack_REECA1_candidate.dyr",
    "publishes": [
      "<scenario>/transmission/poi_voltage_pu"
    ],
    "subscribes": [
      "<scenario>/distribution/load_kw"
    ],
    "notes": "The runner can use a post-processed GridPACK POI voltage CSV. Without one, HELICS uses the retained sag-train fallback only as a coupling demo after GridPACK validates the real RAW/DYR case. Manuscript Fig. 6 uses the exported GridPACK branch-fault POI traces under results_event_sweep."
  },
  "distribution_federate": {
    "backend": "OpenDSSDirect.py",
    "case_requirement": "Data-center feeder equivalent at the 34.5 kV AC side",
    "publishes": [
      "<scenario>/distribution/datacenter_ac_voltage_pu",
      "<scenario>/distribution/load_kw",
      "<scenario>/distribution/load_kvar"
    ],
    "subscribes": [
      "<scenario>/transmission/poi_voltage_pu",
      "<scenario>/controller/local_q_kvar",
      "<scenario>/controller/central_q_kvar"
    ]
  },
  "controller_federate": {
    "backend": "Python HELICS value federate",
    "cases": [
      "C1",
      "C2",
      "C3"
    ],
    "publishes": [
      "<scenario>/controller/local_q_kvar",
      "<scenario>/controller/central_q_kvar"
    ],
    "subscribes": [
      "<scenario>/distribution/datacenter_ac_voltage_pu"
    ]
  },
  "disturbance": {
    "gridpack_event_sweep": "results_event_sweep/gridpack_poi_voltage_event_*.csv",
    "fallback_event_csv": "../griddyn_td_dynamic_var/eastern_interconnection_2024_voltage_sag_train.csv",
    "fault_branch": "137 150",
    "poi_bus": 150,
    "description": "Manuscript Fig. 6 uses six shifted GridPACK branch-fault POI traces exported at bus 150 and passed to HELICS/OpenDSS at 20 ms resolution. The fallback CSV is used only when no GridPACK POI voltage recorder CSV is supplied for a coupling demo."
  },
  "metrics": [
    "minimum_poi_voltage_pu",
    "minimum_34p5kv_service_voltage_pu",
    "data_center_load_served_fraction",
    "ride_through_pass",
    "maximum_dynamic_var_mvar",
    "all_opendss_solves_converged"
  ]
}
