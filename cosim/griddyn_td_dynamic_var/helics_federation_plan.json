    "data_center_load_served_fraction",
    "ride_through_pass",
    "recovery_time_to_90pct_s",
    "maximum_dynamic_var_mvar",
    "rms_dynamic_var_mvar",
    "ltc_tap_operations",
    "capacitor_bank_switching_events",
    "var_command_sign_reversals",
    "post_fault_voltage_hunting_pct"
  ]
