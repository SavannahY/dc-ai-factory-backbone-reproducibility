      "<scenario>/distribution/datacenter_ac_voltage_pu",
      "<scenario>/distribution/load_kw",
      "<scenario>/distribution/load_kvar"
    ],
    "subscribes": [
      "<scenario>/transmission/poi_voltage_pu",
      "<scenario>/controller/local_q_kvar",
      "<scenario>/controller/central_q_kvar"
    ]
  },
  "controller_federate": {
    "backend": "Python or PyDSS user-defined controller",
    "cases": [
      "baseline_no_added_dynamic_var",
      "local_sst_34p5kv_dynamic_var",
      "local_sst_with_legacy_voltage_devices",
      "centralized_115_138kv_dynamic_var",
      "coordinated_local_and_centralized"
    ],
    "publishes": [
      "<scenario>/controller/local_q_kvar",
      "<scenario>/controller/central_q_kvar"
    ],
    "subscribes": [
      "<scenario>/distribution/datacenter_ac_voltage_pu"
    ]
  },
  "disturbance": {
    "event_csv": "eastern_interconnection_2024_voltage_sag_train.csv",
